# OpenHub Docker Compose Environment Variables
# Copy to .env and fill in real values before running:
#   cp .env.example .env
#   docker-compose up --build

# Required — set strong values for production
AGENTHUB_ADMIN_USER=admin
AGENTHUB_ADMIN_PASSWORD=changeme-use-a-real-password
AGENTHUB_SECRET_KEY=changeme-at-least-32-random-chars
AGENTHUB_JWT_SECRET_KEY=changeme-at-least-32-random-chars

# Optional — defaults shown
# AGENTHUB_LOG_LEVEL=INFO
# AGENTHUB_HOST=0.0.0.0
# AGENTHUB_PORT=7788
