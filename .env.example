# Agent Hub Configuration
AGENTHUB_HOST=0.0.0.0
AGENTHUB_PORT=7788

# Database
AGENTHUB_DB_PATH=./data/state/agenthub.db

# Storage
AGENTHUB_ARTIFACT_DIR=./data/artifacts

# Cache
REDIS_URL=redis://localhost:6379

# Security
AGENTHUB_SECRET_KEY=your-secret-key-here-change-in-production
AGENTHUB_API_KEYS_FILE=./data/state/api_keys.json

# Logging
AGENTHUB_LOG_LEVEL=INFO
AGENTHUB_LOG_FILE=./logs/agenthub.log

# Task Configuration
AGENTHUB_TASK_LEASE_TTL_SEC=300
AGENTHUB_MAX_AGENTS=100
AGENTHUB_MAX_CONCURRENT_TASKS=50

# Vector Search (Phase 3 Beta) - optional, requires Turso
# Leave AGENTHUB_VECTOR_SEARCH_ENABLED unset for auto-detect from Turso configuration
# AGENTHUB_VECTOR_SEARCH_ENABLED=true
# AGENTHUB_EMBEDDING_PROVIDER=local      # "local" (sentence-transformers) or "openai"
# AGENTHUB_OPENAI_API_KEY=               # required only when EMBEDDING_PROVIDER=openai
#
# OpenAI-compatible endpoint override (e.g. local Ollama):
# After migration 0004 the vector columns are F32_BLOB(768). Recommended 768-dim
# multilingual models: paraphrase-multilingual (mpnet-base-v2) or
# nomic-embed-text. Set AGENTHUB_EMBEDDING_DIM_OVERRIDE=768 to match the column
# width when using the OpenAI-compatible path through Ollama.
# AGENTHUB_EMBEDDING_PROVIDER=openai
# AGENTHUB_OPENAI_API_KEY=ollama
# AGENTHUB_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# AGENTHUB_EMBEDDING_MODEL_OVERRIDE=paraphrase-multilingual
# AGENTHUB_EMBEDDING_DIM_OVERRIDE=768
AGENTHUB_VECTOR_BATCH_SIZE=1000
AGENTHUB_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# Cleanup
AGENTHUB_EVENT_RETENTION_DAYS=30
AGENTHUB_MESSAGE_RETENTION_DAYS=90